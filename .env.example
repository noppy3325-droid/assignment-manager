# Optional: use a different Firebase project from firebase-applet-config.json.
# Device storage works without environment variables or a Google account.
# Firebase web configuration is public. Never put service-account secrets here.
# If changing projects, set every value below together.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
